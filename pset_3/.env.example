# Copia este archivo como .env (no se versiona) y completa los valores.

# Identificador de la cuenta de Snowflake: <organizacion>-<cuenta>
SNOWFLAKE_ACCOUNT=ORGANIZACION-CUENTA

# Contraseña local de la base PostgreSQL de MLflow (elige una; solo se usa dentro de Docker)
MLFLOW_DB_PASSWORD=<elige_una_contrasena_local>

# Token para entrar a JupyterLab en http://localhost:8888 (elige uno)
JUPYTER_TOKEN=<elige_un_token_local>

# SHA del commit de GitHub con el que ejecutas (se registra como tag commit_git en cada corrida de MLflow)
GIT_COMMIT=<sha_del_commit>
