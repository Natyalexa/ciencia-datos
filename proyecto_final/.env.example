# Copia este archivo como .env (NO se sube al repositorio) y completa los valores.

# ---- Snowflake -------------------------------------------------------------------------------
# Identificador de la cuenta: <organizacion>-<cuenta>
SNOWFLAKE_ACCOUNT=ORGANIZACION-CUENTA
# Kestra lee las variables con prefijo ENV_ como {{ envs.snowflake_account }}
ENV_SNOWFLAKE_ACCOUNT=ORGANIZACION-CUENTA
# Llave privada RSA (secrets/rsa_key.p8) en base64. Kestra la lee como secreto.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("$PWD\secrets\rsa_key.p8"))
SECRET_SNOWFLAKE_PRIVATE_KEY=<llave_privada_en_base64>

# ---- Contraseñas locales (elige las tuyas; solo se usan dentro de Docker) ------------------------
KESTRA_DB_PASSWORD=<elige_una_contrasena_local>
MLFLOW_DB_PASSWORD=<elige_una_contrasena_local>
JUPYTER_TOKEN=<elige_un_token_local>
# MLFLOW_DB_PASSWORD debe ser LA MISMA del PSet #3: la base de MLflow ya existe en su volumen.
# Volúmenes de MLflow del PSet #3 (ver: docker volume ls). Cambia solo si tienen otro nombre.
MLFLOW_DB_VOLUME=pset_3_mlflow-db-data
MLFLOW_ARTIFACTS_VOLUME=pset_3_mlflow-artifacts

# ---- API ----------------------------------------------------------------------------------------
# Token para los endpoints /admin/* (recargar, interruptor de respaldo, vaciar registro)
ADMIN_TOKEN=<elige_un_token_local>
# El mismo token en base64, para Kestra:
#   PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("<tu_token>"))
SECRET_ADMIN_TOKEN=<token_en_base64>
# Interruptor de respaldo al arrancar (true = decide la regla de negocio, no el modelo)
MODO_RESPALDO=false
# Tag de la imagen publicada por cd.yml en GHCR (hash del commit). latest = la última publicada.
API_TAG=latest

# ---- Trazabilidad -------------------------------------------------------------------------------
# SHA del commit con el que ejecutas (se registra como tag commit_git en MLflow)
GIT_COMMIT=<sha_del_commit>
