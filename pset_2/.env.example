# Copia este archivo como .env (no se versiona) y completa los valores.

# Identificador de tu cuenta de Snowflake: <organizacion>-<cuenta>
SNOWFLAKE_ACCOUNT=ORGANIZACION-CUENTA

# Contrasena local de la base PostgreSQL que guarda los metadatos de Kestra (elige una; solo se usa dentro de Docker).
KESTRA_DB_PASSWORD=<elige_una_contrasena_local>

# Llave privada RSA (secrets/rsa_key.p8) codificada en base64. Kestra la lee como secreto.
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("$PWD\secrets\rsa_key.p8"))
#   Mac / Linux:          base64 -w0 secrets/rsa_key.p8
SECRET_SNOWFLAKE_PRIVATE_KEY=<llave_privada_en_base64>
